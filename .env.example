# Copy this file to .env and fill in your own values. Never commit .env.

# Which LLM to use: "ollama" (free, local) or "anthropic" (Claude API, paid)
LLM_PROVIDER=ollama

# Ollama (local) - run `ollama pull qwen3:8b` first
OLLAMA_MODEL=qwen3:8b

# Claude API - create a key at https://console.anthropic.com
# claude-haiku-5-5 is the low-cost option for bulk testing
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5

# Market data
DATA_PROVIDER=yfinance
FINNHUB_API_KEY=

# Charles Schwab Developer API (add once your app is approved)
SCHWAB_APP_KEY=
SCHWAB_APP_SECRET=
