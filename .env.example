# Copy this file to .env and fill in your own values. Never commit .env.

# Which LLM to use: "ollama" (free, local) or "anthropic" (Claude API, paid)
LLM_PROVIDER=ollama

# Lower-risk alternative search: "llm" lets the model propose candidates; "rules" uses default
# choices only (no LLM calls, faster)
TOT_PROPOSER=llm

# Ollama (local) - run `ollama pull qwen3:8b` first
OLLAMA_MODEL=qwen3:8b

# Claude API - create a key at https://console.anthropic.com
# claude-haiku-5-5 is what the evaluation and demo use (about 1 cent per analysis)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5

# Market data: replay recorded data (repeatable, offline; freezes the clock at the recording time) ...
DATA_PROVIDER=snapshot
SNAPSHOT_PATH=data/snapshots/2026-11-13-scenarios.json.gz
# ... or fetch live data from Yahoo Finance:
# DATA_PROVIDER=yfinance
