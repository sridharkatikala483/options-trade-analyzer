# Copy this file to .env and fill in your own values. Never commit .env.

# Which LLM to use: "ollama" (free, local) or "anthropic" (Claude API, paid)
LLM_PROVIDER=ollama

# Lower-risk alternative search: "llm" lets the model propose candidates; "rules" uses default
# choices only (no LLM calls, faster)
TOT_PROPOSER=llm

# Ollama (local) - run `ollama pull qwen3:8b` first
OLLAMA_MODEL=qwen3:8b

# Claude API - create a key at https://console.anthropic.com
# claude-haiku-5-5 is the low-cost option for bulk testing
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5

# Market data
DATA_PROVIDER=yfinance
# Replay recorded market data instead (scripts/record_snapshot.py); freezes the clock at the recording time:
# DATA_PROVIDER=snapshot
# SNAPSHOT_PATH=data/snapshots/2026-11-06.json.gz
FINNHUB_API_KEY=

# Charles Schwab Developer API (add once your app is approved)
SCHWAB_APP_KEY=
SCHWAB_APP_SECRET=
